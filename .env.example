# Qwen 3.8 Max — classify headlines + narrate. Kernel still sizes.
# Bitget S2 credits (default):
BITGET_QWEN_API_KEY=
BITGET_QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
BITGET_QWEN_MODEL=qwen3.8-max
#
# Alibaba DashScope OpenAI-compatible instead:
# DASHSCOPE_API_KEY=
# BITGET_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# BITGET_QWEN_MODEL=qwen3.8-max

# Optional Bitget READ-ONLY key (UTA account read). Nightshift snapshots holdings
# then runs the local paper kernel. It does NOT place Bitget orders.
# Bitget → API keys → create → permissions: UTA management READ only. No trade, no withdraw.
# Never paste these in chat.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
